FLASK_ENV=development
SECRET_KEY=change_this_secret_key
JWT_SECRET_KEY=change_this_jwt_secret

# ── Database ──────────────────────────────────────────────────────────────────
# For local MySQL:
#   DB_HOST=localhost
# For PlanetScale (recommended cloud option):
#   DB_HOST=aws.connect.psdb.cloud   ← copy from PlanetScale Connect page
#   DB_USER=                         ← generated username from PlanetScale
#   DB_PASSWORD=                     ← generated password from PlanetScale
# For Aiven MySQL: set DB_SSL_CA to the path of the downloaded ca.pem file
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=internship_management
DB_SSL_CA=                           # path to CA cert (Aiven only; leave empty for PlanetScale/local)
DB_POOL_SIZE=10                      # connections in pool; 10 recommended for cloud DBs

UPLOAD_FOLDER=uploads/resumes
MAX_CONTENT_LENGTH=5242880

# Optional. If empty, the backend uses the public Remotive jobs API.
INTERNSHIP_API_URL=
INTERNSHIP_API_KEY=

# EmailJS (https://www.emailjs.com) — used instead of in-app / WhatsApp alerts
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=


GOOGLE_CLIENT_ID=
MONGO_URI=
MONGO_DB_NAME=internhub

CLIENT_ORIGIN=http://localhost:5173
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5500,http://127.0.0.1:5500
JWT_COOKIE_SECURE=false
JWT_EXPIRES_HOURS=24

